<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Amard.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ================= پالت رنگ ================= -->
            <Color x:Key="Primary">#1A237E</Color>
            <Color x:Key="PrimaryLight">#3949AB</Color>
            <Color x:Key="PrimarySoft">#E8EAF6</Color>
            <Color x:Key="Success">#2E7D32</Color>
            <Color x:Key="SuccessSoft">#E8F5E9</Color>
            <Color x:Key="Danger">#C62828</Color>
            <Color x:Key="DangerSoft">#FDECEA</Color>
            <Color x:Key="PageBackground">#EEF1F8</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="FieldBackground">#FFFFFF</Color>
            <Color x:Key="FieldBorder">#D6DAE5</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="Placeholder">#9AA1B0</Color>

            <!-- ================= برچسب‌ها ================= -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="4,6,4,0" />
            </Style>

            <!-- ================= ورودی‌ها ================= -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Placeholder}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="TitleColor" Value="{StaticResource Placeholder}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- فیلد گرد با حاشیه، دور Entry/Picker -->
            <Style x:Key="Field" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource FieldBackground}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Stroke" Value="{StaticResource FieldBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <!-- ================= کارت‌ها ================= -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Stroke" Value="{StaticResource FieldBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#1A237E" Opacity="0.10" Radius="18" Offset="0,6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= دکمه‌ها ================= -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="SuccessButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}" />
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="1.5" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
