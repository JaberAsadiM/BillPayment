<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Amard.App</RootNamespace>
    <ApplicationId>com.amard.billpayment</ApplicationId>
    <ApplicationTitle>پرداخت قبض</ApplicationTitle>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>

    <!-- Single-project MAUI (Android only) -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- پوشش معماری‌ها: شبیه‌ساز (x86_64) و دستگاه واقعی / POS (arm64 و arm ۳۲ بیتی) -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>

    <!-- Managed AIDL proxy generation -->
    <UseRootNamespaceForManagedAidl>false</UseRootNamespaceForManagedAidl>
  </PropertyGroup>

  <!-- امضای نسخه Release با keystore اختصاصی (SHA-1 ارسالی به آسان‌پرداخت) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>amard-release</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>amard-release-2026</AndroidSigningKeyPass>
    <AndroidSigningStorePass>amard-release-2026</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <!-- AIDL interfaces of AsanPardakht POS service -->
    <AndroidInterfaceDescription Include="Aidl\**\*.aidl" />
  </ItemGroup>

  <ItemGroup>
    <!-- گواهی‌های لنگر اعتماد داخلی (ریشه Certum) برای اعتبارسنجی TLS روی دستگاه‌های قدیمی -->
    <EmbeddedResource Include="Resources\Certs\certum_root.cer" />
    <EmbeddedResource Include="Resources\Certs\certum_intermediate_r39.cer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
