<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Amard.App</RootNamespace>
    <ApplicationId>com.amard.billpayment</ApplicationId>
    <ApplicationTitle>پرداخت قبض</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

    <!-- Single-project MAUI (Android only) -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- پوشش معماری‌ها: شبیه‌ساز (x86_64) و دستگاه واقعی / POS (arm64 و arm ۳۲ بیتی) -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>

    <!-- Managed AIDL proxy generation -->
    <UseRootNamespaceForManagedAidl>false</UseRootNamespaceForManagedAidl>
  </PropertyGroup>

  <ItemGroup>
    <!-- AIDL interfaces of AsanPardakht POS service -->
    <AndroidInterfaceDescription Include="Aidl\**\*.aidl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
