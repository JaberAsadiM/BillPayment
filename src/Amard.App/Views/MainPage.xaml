<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Amard.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Amard.App.Models"
    FlowDirection="RightToLeft"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙ تنظیمات"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="20,16,20,48" Spacing="16">

            <!-- بنر وضعیت اتصال اینترنت دستگاه + دکمه تست اتصال به سرور -->
            <Border BackgroundColor="{Binding ConnectionBannerColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding ConnectionStatusText}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{Binding ConnectionTextColor}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="تست اتصال"
                            Command="{Binding CheckConnectionCommand}"
                            BackgroundColor="{Binding ConnectionTextColor}"
                            TextColor="White"
                            FontSize="12"
                            Padding="14,4"
                            CornerRadius="8" />
                </Grid>
            </Border>

            <!-- هدر با پس‌زمینه گرادیانی -->
            <Border Style="{StaticResource Card}" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource PrimaryLight}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout Spacing="4" Padding="0,6">
                    <Label Text="🧾 پرداخت قبض"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="جستجوی قبض و پرداخت با دستگاه POS"
                           FontSize="13"
                           TextColor="#C5CAE9"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Border>

            <!-- کارت جستجو -->
            <Border Style="{StaticResource Card}">
                <StackLayout Spacing="4">
                    <Label Text="جستجوی قبض" Style="{StaticResource SectionTitle}" />

                    <Label Text="نوع جستجو" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Picker x:Name="SearchTypePicker"
                                Title="انتخاب کنید"
                                SelectedIndexChanged="OnSearchTypeChanged" />
                    </Border>

                    <Label Text="مقدار جستجو" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="SearchValueEntry"
                               Placeholder="مقدار مورد جستجو را وارد کنید"
                               Text="{Binding SearchValue, Mode=TwoWay}" />
                    </Border>

                    <Button Text="🔍 جستجو"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,14,0,0" />
                </StackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{StaticResource Primary}" />

            <!-- کارت لیست پرونده‌های یافت‌شده با کد ملی (فقط کد نوسازی و آدرس) -->
            <Border IsVisible="{Binding HasParvandehs}" Style="{StaticResource Card}">
                <StackLayout Spacing="8">
                    <Label Text="پرونده‌های یافت‌شده" Style="{StaticResource SectionTitle}" />
                    <Label Text="برای مشاهده اطلاعات مالک، روی کد نوسازی مورد نظر ضربه بزنید"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />

                    <CollectionView ItemsSource="{Binding ParvandehList}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedParvandeh, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ParvandehViewModel">
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource FieldBorder}"
                                        StrokeThickness="1"
                                        Padding="12,10"
                                        Margin="0,2,0,2">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>

                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                        <!-- کد نوسازی -->
                                        <Label Grid.Row="0"
                                               Text="{Binding codeN, StringFormat='کد نوسازی: {0}'}"
                                               FontAttributes="Bold"
                                               FontSize="16" />

                                        <!-- آدرس -->
                                        <Label Grid.Row="1"
                                               Text="{Binding Address, StringFormat='آدرس: {0}'}"
                                               FontSize="13"
                                               LineBreakMode="WordWrap"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="پرونده‌ای یافت نشد."
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextSecondary}" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </StackLayout>
            </Border>

            <!-- کارت لیست مالکین یافت‌شده -->
            <Border IsVisible="{Binding HasOwners}" Style="{StaticResource Card}">
                <StackLayout Spacing="8">
                    <Label Text="مالکین یافت‌شده" Style="{StaticResource SectionTitle}" />
                    <Label Text="برای دریافت مبلغ قبض، یک مالک را از لیست انتخاب کنید"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />

                    <CollectionView ItemsSource="{Binding OwnersList}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedOwner, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Owners">
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource FieldBorder}"
                                        StrokeThickness="1"
                                        Padding="12,10"
                                        Margin="0,2,0,2">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <!-- نام و نام خانوادگی -->
                                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding OwnerName, StringFormat='نام و نام خانوادگی: {0}'}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation" />

                                        <!-- کد ملی -->
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding NationalCode, StringFormat='کد ملی: {0}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- ردیف پرونده -->
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding id, StringFormat='ردیف: {0}'}"
                                               FontSize="13"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- نام پدر -->
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Text="{Binding father, StringFormat='نام پدر: {0}'}"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- شماره موبایل مالک (mob) -->
                                        <Label Grid.Row="2" Grid.Column="1"
                                               Text="{Binding mob, StringFormat='موبایل: {0}'}"
                                               FontSize="13"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource TextSecondary}" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="مالکی یافت نشد."
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextSecondary}" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- دکمه دریافت مبلغ قبض برای مالک انتخاب‌شده -->
                    <Button Text="📄 دریافت مبلغ قبض"
                            Command="{Binding GetBillCommand}"
                            IsVisible="{Binding HasSelectedOwner}"
                            Style="{StaticResource OutlineButton}"
                            Margin="0,8,0,0" />
                </StackLayout>
            </Border>

            <!-- کارت لیست قبض‌های یافت‌شده -->
            <Border IsVisible="{Binding HasBills}" Style="{StaticResource Card}">
                <StackLayout Spacing="8">
                    <Label Text="قبض‌های یافت‌شده" Style="{StaticResource SectionTitle}" />
                    <Label Text="برای پرداخت، یک قبض را از لیست انتخاب کنید؛ فقط مبلغ همان قبض پرداخت می‌شود"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />

                    <CollectionView ItemsSource="{Binding BillsList}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedBill, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BillInfo">
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource FieldBorder}"
                                        StrokeThickness="1"
                                        Padding="12,10"
                                        Margin="0,2,0,2">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <!-- صاحب قبض -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding OwnerName}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation" />

                                        <!-- دوره / سال قبض -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Period, StringFormat='دوره: {0}'}"
                                               FontSize="13"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- شناسه قبض -->
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding BillId, StringFormat='شناسه قبض: {0}'}"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- شناسه پرداخت -->
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding PayId, StringFormat='شناسه پرداخت: {0}'}"
                                               FontSize="13"
                                               HorizontalTextAlignment="End"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <!-- مبلغ قبض در کادر برجسته -->
                                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                BackgroundColor="{StaticResource DangerSoft}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,6"
                                                Margin="0,6,0,0">
                                            <Label Text="{Binding AmountRials, StringFormat='مبلغ: {0:N0} ریال'}"
                                                   FontSize="17" FontAttributes="Bold"
                                                   TextColor="{StaticResource Danger}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="قبضی یافت نشد."
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextSecondary}" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- دکمه پرداخت قبض انتخاب‌شده -->
                    <Button Text="💳 پرداخت قبض انتخاب‌شده با دستگاه POS"
                            Command="{Binding PayCommand}"
                            IsVisible="{Binding HasSelectedBill}"
                            Style="{StaticResource SuccessButton}"
                            Margin="0,8,0,0" />
                </StackLayout>
            </Border>

            <!-- وضعیت -->
            <Border IsVisible="{Binding HasStatusMessage}"
                    BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,12"
                    Margin="0,4,0,0">
                <Label Text="{Binding StatusMessage}"
                       FontSize="15"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       LineBreakMode="WordWrap" />
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>
